      "isDeleted": false,
      "boundElements": null,
      "updated": 1789763250445,
      "link": null,
      "locked": false,
      "text": "The same machine runs both scans. Models search, read, and write; the code checks their work and decides what passes.",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The same machine runs both scans. Models search, read, and write; the code checks their work and decides what passes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
